#include <winver.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VER_NUM@
PRODUCTVERSION @VER_NUM@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "AionPingMeter contributors"
            VALUE "FileDescription", "Lightweight, precise ping overlay for Aion 2 (Global)"
            VALUE "FileVersion", "@VER_STR@"
            VALUE "InternalName", "AionPingMeter"
            VALUE "LegalCopyright", "Copyright \251 2026 AionPingMeter contributors"
            VALUE "OriginalFilename", "AionPingMeter.exe"
            VALUE "ProductName", "AionPingMeter"
            VALUE "ProductVersion", "@VER_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
